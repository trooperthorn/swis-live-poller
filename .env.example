# Copy to .env (which is gitignored) or export these in your process manager. Never commit
# a real .env file.

SWIS_HOST=orion.example.internal
SWIS_USER=svc-live-poller
SWIS_PASSWORD=changeme
SWIS_VERIFY_TLS=true
# Only needed if SWIS presents a certificate from an internal CA that is not already in the
# system trust store. Path to a PEM bundle.
SWIS_CA_BUNDLE=

POLL_INTERVAL_SECONDS=20
SWIS_GPS_CUSTOM_PROPERTIES=GPSLocation,VehiclePosition

PUSH_URL=https://your-pwa.pages.dev/api/live-ingest
PUSH_TOKEN=changeme
