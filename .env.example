# Copy to .env (which is gitignored) or export these in your process manager. Never commit
# a real .env file.

SWIS_HOST=orion.example.internal
SWIS_USER=svc-live-poller
SWIS_PASSWORD=changeme
SWIS_VERIFY_TLS=true
# Only needed if SWIS presents a certificate from an internal CA that is not already in the
# system trust store. Path to a PEM bundle.
SWIS_CA_BUNDLE=

POLL_INTERVAL_SECONDS=20
SWIS_GPS_CUSTOM_PROPERTIES=GPSLocation,VehiclePosition
# The default-shipped custom property SolarWinds installs commonly carry a place name in.
# Set to empty to disable the City/Nominatim fallback entirely.
SWIS_CITY_CUSTOM_PROPERTY=City

PUSH_URL=https://your-pwa.pages.dev/api/live-ingest
PUSH_TOKEN=changeme

# Nominatim (OpenStreetMap) geocoding for the City fallback. A descriptive User-Agent with a
# contact is required by Nominatim's usage policy.
GEOCODE_CACHE_PATH=geocode_cache.json
NOMINATIM_USER_AGENT=swis-live-poller/1.0 (contact: strife1012@gmail.com)
